# Multi-stage Dockerfile for Voxinar BullMQ Background Worker
# Only builds and runs scripts/worker.ts — does not include Next.js frontend 
FROM node:22-slim AS deps

WORKDIR /app

# Install pnpm 9 matching lockfileVersion 9.0
RUN npm install -g pnpm@9

# Copy package manifests
COPY package.json pnpm-lock.yaml ./

# Install dependencies using frozen lockfile without running postinstall scripts yet
RUN pnpm install --frozen-lockfile --ignore-scripts

# Runtime
FROM node:22-slim AS runner

# Install dumb-init (PID 1 signal forwarding) and runtime libraries for Prisma
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends dumb-init openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
ENV PATH="/app/node_modules/.bin:$PATH"

# Copy installed dependencies and binaries from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy only files required for worker runtime and Prisma generation
COPY package.json tsconfig.json prisma.config.ts ./
COPY prisma ./prisma
COPY scripts/worker.ts ./scripts/worker.ts
COPY src ./src

# Generate Prisma Client
RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" prisma generate

# Ensure non-root node user has ownership of the application directory
RUN chown -R node:node /app

USER node

ENTRYPOINT ["dumb-init", "--"]

CMD ["tsx", "scripts/worker.ts"]
